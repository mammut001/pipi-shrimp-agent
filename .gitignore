# Local desktop test artifacts
/.playwright-cli/
/.tmp-*
/.codex-tauri-dev*
/.tauri-dev.log
/build-stderr.log
/build-stdout.log
/F*autoresearch-loop-*
/F*autoresearch-rundir-*
/F*autoresearch-metrics-*
