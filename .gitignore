node-scripts/.env
# /docs used to be entirely ignored. We now re-include the architecture-
# governance and concept docs that ship with the repo. The historical
# tracked files (README.md, audits/, design/, windows-terminal-profiles.md,
# architecture/) continue to be reachable, and we whitelist the new
# concepts/ subtree so it lands in git too.
!/docs/README.md
!/docs/audits/
!/docs/design/
!/docs/architecture/
!/docs/concepts/
!/docs/windows-terminal-profiles.md

# Vite build cache files
vite.config.ts.timestamp-*.mjs
*.timestamp-*
*.timestamp-*.mjs
*.patch
fix_*.mjs
patch_*.mjs
test_output.*
debug_*.mjs
/test_*.mjs
/test.typ
RELEASE_0.0.2.md
check_browser.cjs
check_browser.js
package-lock.json

